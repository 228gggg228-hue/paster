            function splitTextIntoChunks(text, maxBytes) {
                const chunks = [];
                let currentChunk = '';
                let currentBytes = 0;
                const lines = text.split('\n');
                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    const lineWithNewline = line + (i < lines.length - 1 ? '\n' : '');
                    const lineBytes = new Blob([lineWithNewline]).size;
                    if (lineBytes > maxBytes) {
                        if (currentChunk) { chunks.push(currentChunk); currentChunk = ''; currentBytes = 0; }
                        let buffer = '', bufferBytes = 0;
                        for (const char of line) {
                            const charBytes = new Blob([char]).size;
                            if (bufferBytes + charBytes > maxBytes) {
                                chunks.push(buffer); buffer = ''; bufferBytes = 0;
                            }
                            buffer += char; bufferBytes += charBytes;
                        }
                        if (buffer) {
                            currentChunk = buffer + (i < lines.length - 1 ? '\n' : '');
                            currentBytes = new Blob([currentChunk]).size;
                        }
                        continue;
                    }
                    if (currentBytes + lineBytes > maxBytes) {
                        chunks.push(currentChunk);
                        currentChunk = lineWithNewline;
                        currentBytes = lineBytes;
                    } else {
                        currentChunk += lineWithNewline;
                        currentBytes += lineBytes;
                    }
                }
                if (currentChunk) chunks.push(currentChunk);
                return chunks;
            }

