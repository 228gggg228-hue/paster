            function utf8ToBase64(str) {
                const bytes = new TextEncoder().encode(str);
                let binary = '';
                const chunkSize = 0x8000;
                for (let i = 0; i < bytes.length; i += chunkSize) {
                    const chunk = bytes.subarray(i, i + chunkSize);
                    binary += String.fromCharCode.apply(null, chunk);
                }
                return btoa(binary);
            }

            async function saveToGithub() {
                const token = ghToken.value.trim();
                const owner = ghOwner.value.trim();
                const repo = ghRepo.value.trim();
                const branch = ghBranch.value.trim() || 'main';
                let path = ghPath.value.trim();
                const message = ghMessage.value.trim() || `Update ${path || 'file'}`;

                if (!token) { showTextError('Введите GitHub токен'); return; }
                if (!owner) { showTextError('Введите владельца репозитория'); return; }
                if (!repo) { showTextError('Введите название репозитория'); return; }
                if (!path) { showTextError('Введите путь к файлу'); return; }
                path = path.replace(/^\/+/, '');

                ghSubmitBtn.disabled = true;
                const originalHTML = ghSubmitBtn.innerHTML;
                ghSubmitBtn.innerHTML = '<span class="spinner"></span> Сохранение...';
                hideTextError();

                const apiBase = `https://api.github.com/repos/${owner}/${repo}/contents/${encodeURIComponent(path).replace(/%2F/g, '/')}`;
                const contentBase64 = utf8ToBase64(currentFileText);

                try {
                    let sha = null;
                    try {
                        const getResp = await fetch(`${apiBase}?ref=${encodeURIComponent(branch)}`, {
                            headers: {
                                'Authorization': `Bearer ${token}`,
                                'Accept': 'application/vnd.github.v3+json'
                            }
                        });
                        if (getResp.ok) {
                            const data = await getResp.json();
                            sha = data.sha;
                        } else if (getResp.status === 404) {
                            sha = null;
                        } else {
                            const errData = await getResp.json().catch(() => ({}));
                            throw new Error(errData.message || `Ошибка проверки файла: ${getResp.status}`);
                        }
                    } catch (e) {
                        if (e.message && !e.message.includes('404') && !e.message.includes('Ошибка проверки')) throw e;
                    }

                    const body = { message, content: contentBase64, branch };
                    if (sha) body.sha = sha;

                    const putResp = await fetch(apiBase, {
                        method: 'PUT',
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Content-Type': 'application/json',
                            'Accept': 'application/vnd.github.v3+json'
                        },
                        body: JSON.stringify(body)
                    });

                    if (!putResp.ok) {
                        const errData = await putResp.json().catch(() => ({}));
                        throw new Error(errData.message || `Ошибка ${putResp.status}`);
                    }

                    const result = await putResp.json();
                    const fileUrl = result.content && result.content.html_url
                        ? result.content.html_url
                        : `https://github.com/${owner}/${repo}/blob/${branch}/${path}`;

                    saveGithubSettings();
                    githubModal.classList.add('hidden');
                    saveStatus.innerHTML = `✅ Сохранено в GitHub: <a href="${fileUrl}" target="_blank" rel="noopener noreferrer">${fileUrl}</a>`;
                    saveStatus.style.display = 'block';
                    window.open(fileUrl, '_blank', 'noopener,noreferrer');
                } catch (err) {
                    let msg = err.message;
                    if (msg.includes('Failed to fetch') || msg.includes('NetworkError')) {
                        msg = 'Не удалось связаться с GitHub. Проверьте интернет.';
                    }
                    showTextError('Ошибка GitHub: ' + msg);
                } finally {
                    ghSubmitBtn.disabled = false;
                    ghSubmitBtn.innerHTML = originalHTML;
                }
            }

            ghSubmitBtn.addEventListener('click', saveToGithub);
            loadGithubSettings();

            rawTextInput.addEventListener('paste', () => {
                setTimeout(() => { if (rawTextInput.value.trim()) loadText(); }, 30);
            });
            rawTextInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); loadText(); }
            });
            loadBtn.addEventListener('click', loadText);
            pasteTextBtn.addEventListener('click', handlePasteText);
            clearTextBtn.addEventListener('click', handleClearText);
            copyTextBtn.addEventListener('click', handleCopyText);
            downloadTextBtn.addEventListener('click', handleDownload);
            saveBtn.addEventListener('click', handleSave);

            /* =====================================================
               ВКЛАДКА 3: Raw → loadstring для Roblox
               ===================================================== */
            const rawRobloxInput = document.getElementById('rawRobloxInput');
            const makeRobloxBtn = document.getElementById('makeRobloxBtn');
            const pasteRobloxBtn = document.getElementById('pasteRobloxBtn');
            const clearRobloxBtn = document.getElementById('clearRobloxBtn');
            const robloxError = document.getElementById('robloxError');
            const robloxErrorText = document.getElementById('robloxErrorText');
            const robloxResultSection = document.getElementById('robloxResultSection');
            const robloxOutput = document.getElementById('robloxOutput');
            const copyRobloxBtn = document.getElementById('copyRobloxBtn');

            function autoResizeTextarea() {
                robloxOutput.style.height = 'auto';
                robloxOutput.style.height = robloxOutput.scrollHeight + 'px';
            }

            function makeRobloxCommand(rawUrl) {
                const trimmed = rawUrl.trim();
                if (!trimmed) throw new Error('Пустая ссылка');
                try { new URL(trimmed); }
                catch { throw new Error('Некорректный URL. Проверьте ссылку.'); }
                const safeUrl = trimmed.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
                return `loadstring(game:HttpGet("${safeUrl}"))()`;
            }

            function showRobloxError(msg) {
                robloxErrorText.textContent = msg;
                robloxError.classList.remove('hidden');
                robloxResultSection.style.display = 'none';
                robloxOutput.value = '';
            }
            function hideRobloxError() { robloxError.classList.add('hidden'); }

            function handleMakeRoblox() {
                const val = rawRobloxInput.value.trim();
                if (!val) { showRobloxError('Введите raw-ссылку на скрипт'); return; }
                try {
                    const cmd = makeRobloxCommand(val);
                    robloxOutput.value = cmd;
                    robloxResultSection.style.display = 'block';
                    hideRobloxError();
                    autoResizeTextarea();
                    copyRobloxBtn.textContent = 'Копировать';
                    copyRobloxBtn.classList.remove('copied');
                } catch (err) { showRobloxError(err.message); }
            }

            async function handlePasteRoblox() {
                try {
                    const text = await navigator.clipboard.readText();
                    if (text) { rawRobloxInput.value = text.trim(); handleMakeRoblox(); }
                    else showRobloxError('Буфер обмена пуст');
                } catch { showRobloxError('Нет доступа к буферу. Вставьте вручную (Ctrl+V).'); }
            }

            function handleClearRoblox() {
                rawRobloxInput.value = '';
                robloxOutput.value = '';
                robloxResultSection.style.display = 'none';
                hideRobloxError();
                rawRobloxInput.focus();
            }

            async function handleCopyRoblox() {
                const text = robloxOutput.value;
                if (!text) return;
                try { await navigator.clipboard.writeText(text); }
                catch { robloxOutput.select(); document.execCommand('copy'); }
                copyRobloxBtn.textContent = 'Скопировано!';
                copyRobloxBtn.classList.add('copied');
                setTimeout(() => {
                    copyRobloxBtn.textContent = 'Копировать';
                    copyRobloxBtn.classList.remove('copied');
                }, 1500);
            }

            rawRobloxInput.addEventListener('paste', () => {
                setTimeout(() => { if (rawRobloxInput.value.trim()) handleMakeRoblox(); }, 30);
            });
            rawRobloxInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); handleMakeRoblox(); }
            });

            makeRobloxBtn.addEventListener('click', handleMakeRoblox);
            pasteRobloxBtn.addEventListener('click', handlePasteRoblox);
            clearRobloxBtn.addEventListener('click', handleClearRoblox);
            copyRobloxBtn.addEventListener('click', handleCopyRoblox);

            rawLinkInput.focus();
        })();
    </script>
</body>
