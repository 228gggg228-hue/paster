<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raw-инструменты</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body { height: 100%; }

        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            background: #f6f8fa;
            min-height: 100vh;
            padding: 1.5rem;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: background 0.25s, color 0.2s;
            position: relative;
            overflow-x: hidden;
        }

        body.dark { background: #0d1117; }

        /* ====== Фон ====== */
        #bgLayer {
            position: fixed;
            inset: 0;
            z-index: -2;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            transition: opacity 0.4s ease;
            pointer-events: none;
            opacity: 0;
        }

        #bgLayer.active { opacity: 1; }

        #bgLayer.anim-pan {
            animation: bgPan 30s ease-in-out infinite alternate;
            background-size: 120% 120%;
        }
        @keyframes bgPan {
            0%   { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }

        #bgLayer.anim-zoom {
            animation: bgZoom 25s ease-in-out infinite alternate;
        }
        @keyframes bgZoom {
            0%   { transform: scale(1); }
            100% { transform: scale(1.25); }
        }

        #bgLayer.anim-gradient {
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab, #7c3aed, #2da44e);
            background-size: 400% 400%;
            animation: bgGradient 15s ease infinite;
        }
        @keyframes bgGradient {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        #bgOverlay {
            position: fixed;
            inset: 0;
            z-index: -1;
            background: rgba(0,0,0,0);
            transition: background 0.3s;
            pointer-events: none;
        }

        #bgLayer.blurred {
            filter: blur(8px);
            transform: scale(1.05);
        }

        /* ====== Карточка ====== */
        .card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 12px 28px rgba(0,0,0,0.08);
            max-width: 720px;
            width: 100%;
            padding: 2rem;
            transition: background 0.25s, box-shadow 0.2s, backdrop-filter 0.25s;
            position: relative;
            z-index: 1;
        }

        body.dark .card {
            background: #161b22;
            box-shadow: 0 12px 28px rgba(0,0,0,0.5);
            color: #e6edf3;
        }

        /* Прозрачность задаётся через CSS-переменные из JS:
           --card-alpha     — альфа-канал фона карточки (0..1)
           --card-blur      — размытие карточки в px
           Значения по умолчанию — непрозрачная карточка */
        .card {
            --card-alpha: 1;
            --card-blur: 0px;
        }

        body.has-bg .card {
            background: rgba(255, 255, 255, var(--card-alpha));
            backdrop-filter: blur(var(--card-blur));
            -webkit-backdrop-filter: blur(var(--card-blur));
        }

        body.dark.has-bg .card {
            background: rgba(22, 27, 34, var(--card-alpha));
        }

        h1 {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1f2328;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
        }

        body.dark h1 { color: #e6edf3; }

        h1 span {
            background: #1f2328;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 500;
            padding: 0.25rem 0.65rem;
            border-radius: 20px;
        }

        body.dark h1 span {
            background: #e6edf3;
            color: #0d1117;
        }

        .header-buttons {
            margin-left: auto;
            display: flex;
            gap: 0.4rem;
            flex: 0 0 auto;
        }

        .theme-toggle, .bg-toggle {
            background: transparent;
            border: 1.5px solid #d0d7de;
            border-radius: 40px;
            padding: 0.3rem 0.8rem;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            cursor: pointer;
            color: #24292f;
            transition: background 0.2s, border 0.2s;
            font-weight: 500;
            flex: 0 0 auto;
            font-family: inherit;
        }

        body.dark .theme-toggle, body.dark .bg-toggle {
            border-color: #30363d;
            color: #e6edf3;
            background: #21262d;
        }

        .theme-toggle:hover, .bg-toggle:hover { background: #f0f2f5; }
        body.dark .theme-toggle:hover, body.dark .bg-toggle:hover { background: #30363d; }

        .tabs {
            display: flex;
            background: #f0f2f5;
            border-radius: 14px;
            padding: 0.35rem;
            margin-bottom: 1.5rem;
            gap: 0.25rem;
            transition: background 0.2s;
        }

        body.dark .tabs { background: #21262d; }

        .tab {
            flex: 1;
            border: none;
            background: transparent;
            padding: 0.7rem 0.4rem;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 500;
            color: #57606a;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.3rem;
            white-space: nowrap;
        }

        body.dark .tab { color: #8b949e; }
        .tab:hover:not(.active) { background: rgba(255,255,255,0.6); }
        body.dark .tab:hover:not(.active) { background: rgba(255,255,255,0.05); }

        .tab.active {
            background: #fff;
            color: #1f2328;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        }

        body.dark .tab.active {
            background: #0d1117;
            color: #e6edf3;
            box-shadow: 0 2px 6px rgba(0,0,0,0.4);
        }

        .tab-panel { display: none; }
        .tab-panel.active { display: block; animation: fadeIn 0.2s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .subhead {
            font-size: 0.9rem;
            color: #57606a;
            margin-bottom: 1.3rem;
            border-left: 4px solid #2da44e;
            padding-left: 1rem;
            line-height: 1.4;
        }

        body.dark .subhead { color: #8b949e; }
        .subhead.roblox { border-left-color: #e03e3e; }

        label {
            font-weight: 500;
            font-size: 0.9rem;
            color: #24292f;
            display: block;
            margin-bottom: 0.4rem;
        }

        body.dark label { color: #e6edf3; }

        input[type="text"], textarea {
            width: 100%;
            padding: 0.9rem 1.1rem;
            font-size: 0.95rem;
            font-family: 'SF Mono', 'Fira Code', monospace;
            border: 1.5px solid #d0d7de;
            border-radius: 12px;
            background: #f9fafb;
            color: #1f2328;
            transition: border 0.15s, box-shadow 0.15s, background 0.15s;
            margin-bottom: 1rem;
        }

        body.dark input[type="text"],
        body.dark textarea {
            background: #0d1117;
            border-color: #30363d;
            color: #e6edf3;
        }

        input[type="text"]:focus,
        textarea:focus {
            outline: none;
            border-color: #2da44e;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(45,164,78,0.15);
        }

        body.dark input[type="text"]:focus,
        body.dark textarea:focus {
            background: #0d1117;
            border-color: #2da44e;
        }

        .actions {
            display: flex;
            gap: 0.7rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        button {
            border: none;
            border-radius: 12px;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.85rem 1.4rem;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s, border 0.15s;
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            flex: 1 1 auto;
            border: 1px solid transparent;
        }

        button:active { transform: scale(0.97); }
        button:disabled { opacity: 0.5; cursor: not-allowed; }

        .btn-primary {
            background: #2da44e;
            color: white;
            box-shadow: 0 2px 6px rgba(45,164,78,0.3);
        }
        .btn-primary:hover:not(:disabled) { background: #2c974b; }

        .btn-roblox {
            background: #e03e3e;
            color: white;
            box-shadow: 0 2px 6px rgba(224,62,62,0.3);
        }
        .btn-roblox:hover:not(:disabled) { background: #cc3535; }

        .btn-secondary {
            background: #fff;
            color: #24292f;
            border: 1.5px solid #d0d7de;
        }
        .btn-secondary:hover:not(:disabled) { background: #f3f4f6; }

        body.dark .btn-secondary {
            background: #21262d;
            color: #e6edf3;
            border-color: #30363d;
        }
        body.dark .btn-secondary:hover:not(:disabled) { background: #30363d; }

        .btn-copy {
            background: #0969da;
            color: white;
            padding: 0.7rem 1.2rem;
            font-size: 0.9rem;
        }
        .btn-copy:hover { background: #0a5fc2; }
        .btn-copy.copied { background: #2da44e; }

        .result-section {
            margin-top: 1rem;
            background: #f6f8fa;
            border-radius: 16px;
            padding: 1.1rem;
            border: 1px solid #e6e8eb;
            transition: background 0.2s, border 0.2s;
        }

        body.dark .result-section {
            background: #0d1117;
            border-color: #30363d;
        }

        .result-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #57606a;
            font-weight: 600;
            margin-bottom: 0.6rem;
        }

        body.dark .result-label { color: #8b949e; }

        .result-box {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            background: #fff;
            border-radius: 12px;
            padding: 0.55rem 0.55rem 0.55rem 1rem;
            border: 1px solid #d0d7de;
            flex-wrap: wrap;
        }

        body.dark .result-box {
            background: #161b22;
            border-color: #30363d;
        }

        .result-box input,
        .result-box textarea {
            border: none;
            background: transparent;
            padding: 0.5rem 0;
            box-shadow: none;
            font-size: 0.85rem;
            color: #0969da;
            font-weight: 500;
            flex: 1;
            min-width: 0;
            margin: 0;
            font-family: 'SF Mono', 'Fira Code', monospace;
            resize: none;
            line-height: 1.4;
        }

        body.dark .result-box input,
        body.dark .result-box textarea { color: #58a6ff; }

        .result-box input:focus,
        .result-box textarea:focus {
            box-shadow: none;
            background: transparent;
            border: none;
            outline: none;
        }

        .result-box textarea {
            min-height: 60px;
            overflow: hidden;
        }

        .btn-copy-small {
            background: #eef1f4;
            border-radius: 8px;
            padding: 0.55rem 0.9rem;
            font-size: 0.8rem;
            font-weight: 500;
            color: #24292f;
            border: none;
            cursor: pointer;
            transition: background 0.15s;
            white-space: nowrap;
            flex: 0 0 auto;
            align-self: stretch;
        }

        body.dark .btn-copy-small {
            background: #21262d;
            color: #e6edf3;
        }
        body.dark .btn-copy-small:hover { background: #30363d; }

        .btn-copy-small:hover { background: #e1e5ea; }
        .btn-copy-small.copied { background: #2da44e; color: white; }

        .result-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.6rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .file-info {
            font-size: 0.78rem;
            color: #8c959f;
        }

        body.dark .file-info { color: #6e7681; }

        .result-content {
            background: #0d1117;
            color: #e6edf3;
            border-radius: 12px;
            padding: 1rem;
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.85rem;
            line-height: 1.5;
            max-height: 400px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-word;
            border: 1px solid #30363d;
        }

        body.dark .result-content {
            background: #0d1117;
            border-color: #30363d;
        }

        .error-message {
            color: #cf222e;
            background: #ffebe9;
            border-radius: 10px;
            padding: 0.8rem 1rem;
            font-size: 0.9rem;
            margin-top: 1rem;
            border-left: 4px solid #cf222e;
            display: flex;
            gap: 0.5rem;
        }

        body.dark .error-message {
            background: #3d1a1a;
            color: #ff7b72;
            border-left-color: #ff7b72;
        }

        .error-message.hidden { display: none; }

        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .footer {
            margin-top: 1.5rem;
            text-align: center;
            font-size: 0.78rem;
            color: #8c959f;
            border-top: 1px solid #e6e8eb;
            padding-top: 1rem;
        }

        body.dark .footer {
            border-top-color: #30363d;
            color: #6e7681;
        }

        .download-row {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            margin-top: 0.8rem;
            flex-wrap: wrap;
        }

        .btn-download {
            background: #0969da;
            color: white;
            padding: 0.7rem 1.2rem;
            font-size: 0.9rem;
            border-radius: 12px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
            flex: 0 1 auto;
        }

        .btn-download:hover { background: #0a5fc2; }
        .btn-download:active { transform: scale(0.97); }

        .btn-pastefy {
            background: #7c3aed;
            color: white;
            padding: 0.7rem 1.2rem;
            font-size: 0.9rem;
            border-radius: 12px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
            flex: 0 1 auto;
        }

        .btn-pastefy:hover:not(:disabled) { background: #6d28d9; }
        .btn-pastefy:active:not(:disabled) { transform: scale(0.97); }
        .btn-pastefy:disabled { opacity: 0.6; cursor: not-allowed; }

        .btn-save {
            background: #24292f;
            color: white;
            padding: 0.7rem 1.2rem;
            font-size: 0.9rem;
            border-radius: 12px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
            flex: 0 1 auto;
        }
        body.dark .btn-save { background: #e6edf3; color: #0d1117; }
        .btn-save:hover:not(:disabled) { background: #3a4048; }
        body.dark .btn-save:hover:not(:disabled) { background: #c9d1d9; }
        .btn-save:disabled { opacity: 0.6; cursor: not-allowed; }

        .save-status {
            font-size: 0.8rem;
            color: #2da44e;
            margin-top: 0.4rem;
            font-weight: 500;
            word-break: break-all;
        }

        body.dark .save-status { color: #3fb950; }

        .save-status a {
            color: #0969da;
            text-decoration: none;
        }
        body.dark .save-status a { color: #58a6ff; }
        .save-status a:hover { text-decoration: underline; }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 1rem;
            animation: fadeIn 0.2s ease;
        }

        .modal-overlay.hidden { display: none; }

        .modal {
            background: #fff;
            border-radius: 20px;
            padding: 1.8rem;
            max-width: 460px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            animation: slideUp 0.25s ease;
            max-height: 90vh;
            overflow-y: auto;
        }

        body.dark .modal {
            background: #161b22;
            color: #e6edf3;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .modal h3 {
            font-size: 1.15rem;
            margin-bottom: 0.6rem;
            color: #1f2328;
            font-weight: 600;
        }

        body.dark .modal h3 { color: #e6edf3; }

        .modal p {
            font-size: 0.88rem;
            color: #57606a;
            margin-bottom: 1.2rem;
            line-height: 1.5;
        }

        body.dark .modal p { color: #8b949e; }

        .modal-option {
            display: block;
            width: 100%;
            text-align: left;
            background: #f6f8fa;
            border: 1.5px solid #d0d7de;
            border-radius: 12px;
            padding: 0.9rem 1rem;
            margin-bottom: 0.7rem;
            cursor: pointer;
            transition: all 0.15s;
            font-family: inherit;
            font-size: 0.9rem;
            color: #24292f;
        }

        body.dark .modal-option {
            background: #0d1117;
            border-color: #30363d;
            color: #e6edf3;
        }

        .modal-option:hover {
            border-color: #7c3aed;
            background: #f3e8ff;
        }

        body.dark .modal-option:hover {
            background: #1c1626;
            border-color: #7c3aed;
        }

        .modal-option strong {
            display: block;
            margin-bottom: 0.2rem;
            font-weight: 600;
        }

        .modal-option small {
            color: #8c959f;
            font-size: 0.78rem;
        }

        body.dark .modal-option small { color: #6e7681; }

        .modal-cancel {
            width: 100%;
            background: transparent;
            border: 1.5px solid #d0d7de;
            color: #57606a;
            padding: 0.7rem;
            border-radius: 10px;
            font-size: 0.88rem;
            margin-top: 0.4rem;
            cursor: pointer;
            font-family: inherit;
            font-weight: 500;
        }

        body.dark .modal-cancel {
            border-color: #30363d;
            color: #8b949e;
        }

        .modal-cancel:hover { background: #f0f2f5; }
        body.dark .modal-cancel:hover { background: #21262d; }

        .pastefy-list {
            margin-top: 0.6rem;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .pastefy-list a {
            color: #0969da;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            word-break: break-all;
            padding: 0.3rem 0;
        }
        body.dark .pastefy-list a { color: #58a6ff; }
        .pastefy-list a:hover { text-decoration: underline; }

        .gh-form .field { margin-bottom: 0.8rem; }
        .gh-form label {
            font-size: 0.8rem;
            margin-bottom: 0.25rem;
            color: #57606a;
        }
        body.dark .gh-form label { color: #8b949e; }
        .gh-form input {
            padding: 0.65rem 0.9rem;
            font-size: 0.85rem;
            margin-bottom: 0;
        }
        .gh-form .hint {
            font-size: 0.72rem;
            color: #8c959f;
            margin-top: 0.2rem;
        }
        body.dark .gh-form .hint { color: #6e7681; }
        .gh-form .checkbox-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.82rem;
            color: #57606a;
            margin-bottom: 0.8rem;
        }
        body.dark .gh-form .checkbox-row { color: #8b949e; }
        .gh-form input[type="checkbox"] {
            width: auto;
            margin: 0;
            flex: 0 0 auto;
        }

        .bg-form .field { margin-bottom: 1rem; }
        .bg-form label {
            font-size: 0.82rem;
            margin-bottom: 0.3rem;
            color: #57606a;
            font-weight: 500;
        }
        body.dark .bg-form label { color: #8b949e; }
        .bg-form input[type="text"] {
            padding: 0.7rem 0.95rem;
            font-size: 0.85rem;
            margin-bottom: 0;
        }
        .bg-form input[type="range"] {
            width: 100%;
            margin: 0.3rem 0;
            accent-color: #7c3aed;
        }
        .bg-form .range-value {
            font-size: 0.75rem;
            color: #7c3aed;
            font-weight: 600;
        }
        .bg-form .row {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 0.6rem;
        }
        .bg-form .row input[type="range"] { flex: 1; }

        .bg-presets {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .bg-preset {
            aspect-ratio: 1;
            border-radius: 10px;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.15s;
            background-size: cover;
            background-position: center;
            position: relative;
            overflow: hidden;
        }

        .bg-preset:hover { transform: scale(1.05); }
        .bg-preset.active { border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124,58,237,0.3); }

        .bg-preset.g1 { background: linear-gradient(135deg, #667eea, #764ba2); }
        .bg-preset.g2 { background: linear-gradient(135deg, #f093fb, #f5576c); }
        .bg-preset.g3 { background: linear-gradient(135deg, #4facfe, #00f2fe); }
        .bg-preset.g4 { background: linear-gradient(135deg, #43e97b, #38f9d7); }
        .bg-preset.g5 { background: linear-gradient(135deg, #fa709a, #fee140); }
        .bg-preset.g6 { background: linear-gradient(135deg, #30cfd0, #330867); }
        .bg-preset.g7 { background: linear-gradient(135deg, #a8edea, #fed6e3); }
        .bg-preset.g8 { background: linear-gradient(135deg, #ff9a9e, #fecfef); }

        .bg-anim-options {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }
        .bg-anim-options button {
            flex: 1 1 auto;
            padding: 0.55rem 0.7rem;
            font-size: 0.8rem;
            border-radius: 10px;
            border: 1.5px solid #d0d7de;
            background: #fff;
            color: #24292f;
            cursor: pointer;
            font-family: inherit;
            font-weight: 500;
        }
        body.dark .bg-anim-options button {
            background: #21262d;
            border-color: #30363d;
            color: #e6edf3;
        }
        .bg-anim-options button.active {
            background: #7c3aed;
            color: white;
            border-color: #7c3aed;
        }

        .bg-preview {
            width: 100%;
            height: 100px;
            border-radius: 12px;
            border: 1.5px solid #d0d7de;
            margin-bottom: 1rem;
            background-size: cover;
            background-position: center;
            position: relative;
            overflow: hidden;
        }
        body.dark .bg-preview { border-color: #30363d; }
        .bg-preview::after {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.3);
            pointer-events: none;
        }

        .bg-url-row {
            display: flex;
            gap: 0.4rem;
            margin-bottom: 0.8rem;
        }
        .bg-url-row input { flex: 1; margin-bottom: 0; }
        .bg-url-row button {
            flex: 0 0 auto;
            padding: 0.6rem 0.9rem;
            font-size: 0.8rem;
        }

        /* ====== Мобильная адаптация ====== */
        @media (max-width: 480px) {
            body {
                padding: 1rem;
                align-items: center;
            }
            .card { padding: 1.4rem 1.1rem; }
            h1 { font-size: 1.25rem; }
            button { padding: 0.75rem 1rem; font-size: 0.88rem; }
            .tab { font-size: 0.72rem; padding: 0.6rem 0.2rem; gap: 0.15rem; }
            .result-box { flex-direction: column; align-items: stretch; padding: 0.7rem; }
            .btn-copy-small { width: 100%; align-self: auto; }
            .theme-toggle, .bg-toggle { font-size: 0.72rem; padding: 0.3rem 0.55rem; }
            .download-row { flex-direction: column; align-items: stretch; }
            .btn-download, .btn-pastefy, .btn-save { width: 100%; justify-content: center; }
            .modal { padding: 1.4rem; }
            .header-buttons { width: 100%; justify-content: flex-end; }
        }
    </style>
</head>
<body>
    <div id="bgLayer"></div>
    <div id="bgOverlay"></div>

    <div class="card">
        <h1>
            🛠️ Raw-инструменты
            <span>универсальные</span>
            <div class="header-buttons">
                <button class="bg-toggle" id="bgToggle" title="Настроить фон">🖼️ Фон</button>
                <button class="theme-toggle" id="themeToggle" title="Переключить тему">
                    🌙 <span id="themeIcon">Тёмная</span>
                </button>
            </div>
        </h1>

        <div class="tabs">
            <button class="tab active" data-tab="tab-link">🔗 Ссылка</button>
            <button class="tab" data-tab="tab-text">📄 Текст</button>
            <button class="tab" data-tab="tab-roblox">🎮 Roblox</button>
        </div>

        <!-- ============== ВКЛАДКА 1: Raw → Прямая ссылка ============== -->
        <div class="tab-panel active" id="tab-link">
            <div class="subhead">
                Вставьте <strong>любую raw-ссылку</strong> — получите обычную ссылку для просмотра в браузере.
            </div>

            <label for="rawLinkInput">Raw-ссылка</label>
            <input 
                type="text" 
                id="rawLinkInput" 
                placeholder="https://raw.githubusercontent.com/пользователь/репозиторий/ветка/файл.txt" 
                autocomplete="off"
                spellcheck="false"
            >

            <div class="actions">
                <button class="btn-primary" id="convertBtn">⚡ Преобразовать</button>
                <button class="btn-secondary" id="pasteLinkBtn">📋 Вставить</button>
                <button class="btn-secondary" id="clearLinkBtn">✕ Очистить</button>
            </div>

            <div id="linkError" class="error-message hidden">
                <span>⚠️</span>
                <span id="linkErrorText"></span>
            </div>

            <div class="result-section" id="linkResultSection" style="display: none;">
                <div class="result-label">Обычная ссылка</div>
                <div class="result-box">
                    <input type="text" id="linkOutput" readonly value="">
                    <button class="btn-copy-small" id="copyLinkBtn">Копировать</button>
                </div>
            </div>
        </div>

        <!-- ============== ВКЛАДКА 2: Raw → Текст файла ============== -->
        <div class="tab-panel" id="tab-text">
            <div class="subhead">
                Вставьте <strong>любую raw-ссылку</strong> — получите содержимое файла и кнопки для работы с ним.
            </div>

            <label for="rawTextInput">Ссылка на файл</label>
            <input 
                type="text" 
                id="rawTextInput" 
                placeholder="https://raw.githubusercontent.com/пользователь/репозиторий/ветка/файл.txt" 
                autocomplete="off"
                spellcheck="false"
            >

            <div class="actions">
                <button class="btn-primary" id="loadBtn">⬇️ Загрузить текст</button>
                <button class="btn-secondary" id="pasteTextBtn">📋 Вставить</button>
                <button class="btn-secondary" id="clearTextBtn">✕ Очистить</button>
            </div>

            <div id="textError" class="error-message hidden">
                <span>⚠️</span>
                <span id="textErrorText"></span>
            </div>

            <div class="result-section" id="textResultSection" style="display: none;">
                <div class="result-header">
                    <div class="result-label">Содержимое файла</div>
                    <div class="file-info" id="fileInfo"></div>
                </div>
                <div class="result-content" id="resultContent"></div>
                <div class="download-row">
                    <button class="btn-copy" id="copyTextBtn" style="flex:1;">
                        📋 Копировать весь текст
                    </button>
                    <button class="btn-download" id="downloadTextBtn" style="flex:0 1 auto;">
                        📦 Скачать файл
                    </button>
                    <button class="btn-save" id="saveBtn" style="flex:0 1 auto;">
                        ☁️ Сохранить
                    </button>
                </div>
                <div class="save-status" id="saveStatus" style="display:none;"></div>
            </div>
        </div>

        <!-- ============== ВКЛАДКА 3: Raw → loadstring ============== -->
        <div class="tab-panel" id="tab-roblox">
            <div class="subhead roblox">
                Вставьте <strong>raw-ссылку</strong> — получите готовую команду для Roblox:
                <code style="background:#eef1f4; padding:0.1rem 0.35rem; border-radius:5px; font-size:0.8rem;">loadstring(game:HttpGet("URL"))()</code>
            </div>

            <label for="rawRobloxInput">Raw-ссылка на скрипт</label>
            <input 
                type="text" 
                id="rawRobloxInput" 
                placeholder="https://raw.githubusercontent.com/пользователь/репозиторий/ветка/script.lua" 
                autocomplete="off"
                spellcheck="false"
            >

            <div class="actions">
                <button class="btn-roblox" id="makeRobloxBtn">🎮 Сделать команду</button>
                <button class="btn-secondary" id="pasteRobloxBtn">📋 Вставить</button>
                <button class="btn-secondary" id="clearRobloxBtn">✕ Очистить</button>
            </div>

            <div id="robloxError" class="error-message hidden">
                <span>⚠️</span>
                <span id="robloxErrorText"></span>
            </div>

            <div class="result-section" id="robloxResultSection" style="display: none;">
                <div class="result-label">Команда для Roblox</div>
                <div class="result-box">
                    <textarea id="robloxOutput" readonly rows="2"></textarea>
                    <button class="btn-copy-small" id="copyRobloxBtn">Копировать</button>
                </div>
            </div>
        </div>

        <div class="footer">
            Работает в браузере · Без серверов и слежки · <span id="themeFooter">🌙 тёмная тема</span>
        </div>
    </div>

    <!-- ============== МОДАЛЬНОЕ ОКНО: выбор сервиса ============== -->
    <div class="modal-overlay hidden" id="saveModal">
        <div class="modal">
            <h3>☁️ Сохранить текст</h3>
            <p id="saveModalDescription">Выберите сервис для сохранения:</p>
            <button class="modal-option" id="modalPastefyBtn">
                <strong>🟣 Pastefy</strong>
                <small>Анонимный паст, можно разбить на части</small>
            </button>
            <button class="modal-option" id="modalGithubBtn">
                <strong>🐙 GitHub</strong>
                <small>Создать/обновить файл в вашем репозитории</small>
            </button>
            <button class="modal-cancel" id="modalSaveCancelBtn">Отмена</button>
        </div>
    </div>

    <!-- ============== МОДАЛЬНОЕ ОКНО: Pastefy ============== -->
    <div class="modal-overlay hidden" id="pastefyModal">
        <div class="modal">
            <h3>🟣 Отправка на Pastefy</h3>
            <p id="modalDescription">
                Текст слишком большой для одного паста. Выберите, как отправить.
            </p>
            <button class="modal-option" id="modalSingleBtn">
                <strong>📄 Отправить одним пастом</strong>
                <small>Может не сработать при большом размере</small>
            </button>
            <button class="modal-option" id="modalSplitBtn">
                <strong>✂️ Разделить на части</strong>
                <small id="modalSplitInfo">Будет создано несколько пастов</small>
            </button>
            <button class="modal-cancel" id="modalCancelBtn">Отмена</button>
        </div>
    </div>

    <!-- ============== МОДАЛЬНОЕ ОКНО: GitHub ============== -->
    <div class="modal-overlay hidden" id="githubModal">
        <div class="modal">
            <h3>🐙 Сохранить в GitHub</h3>
            <p>Файл будет создан или обновлён в указанном репозитории.</p>
            <div class="gh-form">
                <div class="field">
                    <label for="ghToken">Personal Access Token</label>
                    <input type="password" id="ghToken" placeholder="ghp_..." autocomplete="off">
                    <div class="hint">Нужен токен с правами <code>repo</code> (или <code>public_repo</code> для публичных). <a href="https://github.com/settings/tokens" target="_blank" rel="noopener">Создать токен</a></div>
                </div>
                <div class="field">
                    <label for="ghOwner">Владелец (логин или организация)</label>
                    <input type="text" id="ghOwner" placeholder="username" autocomplete="off">
                </div>
                <div class="field">
                    <label for="ghRepo">Репозиторий</label>
                    <input type="text" id="ghRepo" placeholder="my-repo" autocomplete="off">
                </div>
                <div class="field">
                    <label for="ghBranch">Ветка</label>
                    <input type="text" id="ghBranch" placeholder="main" autocomplete="off">
                </div>
                <div class="field">
                    <label for="ghPath">Путь к файлу</label>
                    <input type="text" id="ghPath" placeholder="folder/file.txt" autocomplete="off">
                </div>
                <div class="field">
                    <label for="ghMessage">Сообщение коммита</label>
                    <input type="text" id="ghMessage" placeholder="Update file.txt" autocomplete="off">
                </div>
                <div class="checkbox-row">
                    <input type="checkbox" id="ghRemember">
                    <label for="ghRemember" style="margin:0; font-weight:400;">Запомнить настройки и токен (localStorage)</label>
                </div>
            </div>
            <button class="modal-option" id="ghSubmitBtn" style="background:#2da44e; color:white; border-color:#2da44e; text-align:center;">
                <strong>💾 Сохранить</strong>
            </button>
            <button class="modal-cancel" id="ghCancelBtn">Отмена</button>
        </div>
    </div>

    <!-- ============== МОДАЛЬНОЕ ОКНО: ФОН ============== -->
    <div class="modal-overlay hidden" id="bgModal">
        <div class="modal">
            <h3>🖼️ Настройка фона</h3>
            <p>Выберите готовый градиент, вставьте ссылку на картинку или загрузите файл с устройства.</p>

            <div class="bg-form">
                <div class="bg-preview" id="bgPreview"></div>

                <label>Готовые градиенты</label>
                <div class="bg-presets" id="bgPresets">
                    <div class="bg-preset g1" data-css="linear-gradient(135deg, #667eea, #764ba2)"></div>
                    <div class="bg-preset g2" data-css="linear-gradient(135deg, #f093fb, #f5576c)"></div>
                    <div class="bg-preset g3" data-css="linear-gradient(135deg, #4facfe, #00f2fe)"></div>
                    <div class="bg-preset g4" data-css="linear-gradient(135deg, #43e97b, #38f9d7)"></div>
                    <div class="bg-preset g5" data-css="linear-gradient(135deg, #fa709a, #fee140)"></div>
                    <div class="bg-preset g6" data-css="linear-gradient(135deg, #30cfd0, #330867)"></div>
                    <div class="bg-preset g7" data-css="linear-gradient(135deg, #a8edea, #fed6e3)"></div>
                    <div class="bg-preset g8" data-css="linear-gradient(135deg, #ff9a9e, #fecfef)"></div>
                </div>

                <div class="field">
                    <label for="bgUrl">Ссылка на картинку</label>
                    <div class="bg-url-row">
                        <input type="text" id="bgUrl" placeholder="https://example.com/image.jpg" autocomplete="off">
                        <button class="btn-secondary" id="bgApplyUrl" type="button">Применить</button>
                    </div>
                </div>

                <div class="field">
                    <label for="bgFile">Или загрузите с устройства</label>
                    <input type="file" id="bgFile" accept="image/*" style="width:100%; font-size:0.8rem;">
                </div>

                <label>Анимация</label>
                <div class="bg-anim-options" id="bgAnimOptions">
                    <button type="button" data-anim="none">🚫 Без</button>
                    <button type="button" data-anim="pan">🌊 Панорама</button>
                    <button type="button" data-anim="zoom">🔍 Зум</button>
                    <button type="button" data-anim="gradient">🌈 Градиент</button>
                </div>

                <div class="field">
                    <label>Затемнение фона: <span class="range-value" id="bgDarknessVal">30%</span></label>
                    <input type="range" id="bgDarkness" min="0" max="80" value="30">
                </div>

                <div class="field">
                    <label>Размытие фона: <span class="range-value" id="bgBlurVal">0px</span></label>
                    <input type="range" id="bgBlur" min="0" max="20" value="0">
                </div>

                <!-- ✅ НОВЫЙ ПОЛЗУНОК: прозрачность карточки -->
                <div class="field">
                    <label>Прозрачность меню: <span class="range-value" id="bgCardAlphaVal">0%</span></label>
                    <input type="range" id="bgCardAlpha" min="0" max="95" value="0">
                    <div style="font-size:0.72rem; color:#8c959f; margin-top:0.2rem;">
                        0% — непрозрачное, 95% — почти полностью прозрачное (виден фон)
                    </div>
                </div>

                <!-- ✅ НОВЫЙ ПОЛЗУНОК: размытие карточки -->
                <div class="field">
                    <label>Размытие меню: <span class="range-value" id="bgCardBlurVal">0px</span></label>
                    <input type="range" id="bgCardBlur" min="0" max="30" value="0">
                    <div style="font-size:0.72rem; color:#8c959f; margin-top:0.2rem;">
                        Помогает читать текст при высокой прозрачности
                    </div>
                </div>

                <button class="modal-option" id="bgSaveBtn" style="background:#7c3aed; color:white; border-color:#7c3aed; text-align:center; margin-top:0.5rem;">
                    <strong>💾 Применить фон</strong>
                </button>
                <button class="modal-cancel" id="bgResetBtn" style="margin-top:0.4rem;">🗑️ Убрать фон</button>
                <button class="modal-cancel" id="bgCancelBtn">Отмена</button>
            </div>
        </div>
    </div>

    <script>
        (function() {
            /* ============ Тёмная тема ============ */
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const themeFooter = document.getElementById('themeFooter');
            const body = document.body;

            function setTheme(dark) {
                if (dark) {
                    body.classList.add('dark');
                    themeIcon.textContent = 'Светлая';
                    themeFooter.textContent = '☀️ светлая тема';
                } else {
                    body.classList.remove('dark');
                    themeIcon.textContent = 'Тёмная';
                    themeFooter.textContent = '🌙 тёмная тема';
                }
                try { localStorage.setItem('rawToolsDark', dark ? '1' : '0'); } catch(e) {}
            }

            try {
                const saved = localStorage.getItem('rawToolsDark');
                if (saved === '1') setTheme(true);
                else if (saved === '0') setTheme(false);
                else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    setTheme(true);
                } else {
                    setTheme(false);
                }
            } catch(e) { setTheme(false); }

            themeToggle.addEventListener('click', () => {
                setTheme(!body.classList.contains('dark'));
            });

            /* =====================================================
               ФОН + ПРОЗРАЧНОСТЬ КАРТОЧКИ
               ===================================================== */
            const bgToggle = document.getElementById('bgToggle');
            const bgModal = document.getElementById('bgModal');
            const bgLayer = document.getElementById('bgLayer');
            const bgOverlay = document.getElementById('bgOverlay');
            const bgPreview = document.getElementById('bgPreview');
            const bgUrl = document.getElementById('bgUrl');
            const bgApplyUrl = document.getElementById('bgApplyUrl');
            const bgFile = document.getElementById('bgFile');
            const bgAnimOptions = document.getElementById('bgAnimOptions');
            const bgDarkness = document.getElementById('bgDarkness');
            const bgDarknessVal = document.getElementById('bgDarknessVal');
            const bgBlur = document.getElementById('bgBlur');
            const bgBlurVal = document.getElementById('bgBlurVal');
            const bgCardAlpha = document.getElementById('bgCardAlpha');
            const bgCardAlphaVal = document.getElementById('bgCardAlphaVal');
            const bgCardBlur = document.getElementById('bgCardBlur');
            const bgCardBlurVal = document.getElementById('bgCardBlurVal');
            const bgSaveBtn = document.getElementById('bgSaveBtn');
            const bgResetBtn = document.getElementById('bgResetBtn');
            const bgCancelBtn = document.getElementById('bgCancelBtn');
            const bgPresets = document.getElementById('bgPresets');
            const cardEl = document.querySelector('.card');

            const BG_STORAGE_KEY = 'rawToolsBackground';

            let bgState = {
                type: 'none',
                value: '',
                anim: 'none',
                darkness: 30,
                blur: 0,
                cardAlpha: 0,    // 0..95 (проценты прозрачности)
                cardBlur: 0      // 0..30 (px)
            };

            function applyBgState(state, save) {
                bgState = { ...state };

                bgLayer.className = '';
                bgLayer.style.background = '';
                bgLayer.style.backgroundImage = '';
                bgLayer.style.backgroundSize = '';
                bgLayer.style.backgroundPosition = '';
                bgLayer.style.transform = '';

                if (state.type === 'image' && state.value) {
                    bgLayer.style.backgroundImage = `url("${state.value}")`;
                    bgLayer.style.backgroundSize = 'cover';
                    bgLayer.style.backgroundPosition = 'center';
                    bgLayer.classList.add('active');
                    body.classList.add('has-bg');

                    if (state.anim === 'pan') bgLayer.classList.add('anim-pan');
                    else if (state.anim === 'zoom') bgLayer.classList.add('anim-zoom');
                } else if (state.type === 'css' && state.value) {
                    bgLayer.style.background = state.value;
                    bgLayer.style.backgroundSize = 'cover';
                    bgLayer.classList.add('active');
                    body.classList.add('has-bg');

                    if (state.anim === 'gradient') bgLayer.classList.add('anim-gradient');
                } else {
                    bgLayer.classList.remove('active');
                    body.classList.remove('has-bg');
                }

                if (state.blur > 0) {
                    bgLayer.classList.add('blurred');
                    bgLayer.style.filter = `blur(${state.blur}px)`;
                } else {
                    bgLayer.style.filter = '';
                }

                bgOverlay.style.background = `rgba(0,0,0,${state.darkness / 100})`;

                // ✅ Прозрачность карточки: 0% → alpha 1, 95% → alpha 0.05
                const alpha = 1 - (state.cardAlpha / 100);
                cardEl.style.setProperty('--card-alpha', alpha.toFixed(3));
                cardEl.style.setProperty('--card-blur', state.cardBlur + 'px');

                // Превью фона
                if (state.type === 'image' && state.value) {
                    bgPreview.style.backgroundImage = `url("${state.value}")`;
                    bgPreview.style.background = '';
                } else if (state.type === 'css' && state.value) {
                    bgPreview.style.background = state.value;
                    bgPreview.style.backgroundImage = '';
                } else {
                    bgPreview.style.background = '#f0f2f5';
                    bgPreview.style.backgroundImage = '';
                }

                bgAnimOptions.querySelectorAll('button').forEach(b => {
                    b.classList.toggle('active', b.dataset.anim === state.anim);
                });

                bgPresets.querySelectorAll('.bg-preset').forEach(p => {
                    p.classList.toggle('active', p.dataset.css === state.value);
                });

                bgDarkness.value = state.darkness;
                bgDarknessVal.textContent = state.darkness + '%';
                bgBlur.value = state.blur;
                bgBlurVal.textContent = state.blur + 'px';
                bgCardAlpha.value = state.cardAlpha;
                bgCardAlphaVal.textContent = state.cardAlpha + '%';
                bgCardBlur.value = state.cardBlur;
                bgCardBlurVal.textContent = state.cardBlur + 'px';

                if (save) {
                    try { localStorage.setItem(BG_STORAGE_KEY, JSON.stringify(state)); } catch(e) {}
                }
            }

            function loadBgState() {
                try {
                    const saved = localStorage.getItem(BG_STORAGE_KEY);
                    if (saved) {
                        const s = JSON.parse(saved);
                        // Совместимость со старыми настройками
                        s.cardAlpha = s.cardAlpha ?? 0;
                        s.cardBlur = s.cardBlur ?? 0;
                        applyBgState(s, false);
                    } else {
                        // Применяем прозрачность по умолчанию даже без фона
                        applyBgState(bgState, false);
                    }
                } catch(e) {}
            }

            bgToggle.addEventListener('click', () => {
                bgDarkness.value = bgState.darkness;
