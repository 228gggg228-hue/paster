            function convertRawToDirect(rawUrl) {
                const trimmed = rawUrl.trim();
                if (!trimmed) throw new Error('Пустая ссылка');

                let url;
                try { url = new URL(trimmed); }
                catch { throw new Error('Некорректный URL. Проверьте ссылку.'); }

                const host = url.hostname.toLowerCase();
                let path = url.pathname;
                let newHost = host;
                let newPath = path;

                if (host === 'raw.githubusercontent.com') {
                    newHost = 'github.com';
                    const parts = path.split('/').filter(Boolean);
                    if (parts.length < 3) throw new Error('Недостаточно сегментов в пути GitHub');
                    const [user, repo, branch, ...rest] = parts;
                    newPath = `/${user}/${repo}/blob/${branch}${rest.length ? '/' + rest.join('/') : ''}`;
                }
                else if (host === 'gist.githubusercontent.com') {
                    newHost = 'gist.github.com';
                    const parts = path.split('/').filter(Boolean);
                    if (parts.length < 2) throw new Error('Недостаточно сегментов в gist-пути');
                    newPath = `/${parts[0]}/${parts[1]}`;
                }
                else if (host.endsWith('gitlab.com') && path.includes('/raw/')) {
                    newPath = path.replace('/raw/', '/blob/');
                }
                else if (host.endsWith('bitbucket.org') && path.includes('/raw/')) {
                    newPath = path.replace('/raw/', '/src/');
                }
                else if (host === 'cdn.jsdelivr.net') {
                    const match = path.match(/^\/gh\/([^/]+)\/([^/@]+)(?:@([^/]+))?(\/.*)?$/);
                    if (match) {
                        const [, user, repo, version = 'main', filePath = ''] = match;
                        newHost = 'github.com';
                        newPath = `/${user}/${repo}/blob/${version}${filePath}`;
                    } else throw new Error('Не удалось разобрать jsDelivr-ссылку');
                }
                else if (host === 'pastefy.app' && path.endsWith('/raw')) {
                    newPath = path.replace(/\/raw$/, '');
                }
                else if (path.includes('/raw/')) {
                    newPath = path.replace('/raw/', '/blob/');
                }
                else if (path.endsWith('/raw')) {
                    newPath = path.replace(/\/raw$/, '');
                }
                else throw new Error('Не удалось распознать raw-ссылку.');

                return `https://${newHost}${newPath}`;
            }

